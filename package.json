{
  "name": "hush-cli",
  "description": "Command line tool to store and retrieve the contents of .env files in AWS SecretsManager.",
  "author": {
    "name": "Jörn Meyer",
    "email": "joern.meyer@kernpunkt.de",
    "url": "https://joern.url.lol/🧑‍💻"
  },
  "version": "4.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "hush": "dist/hush.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "watch": "rm -rf ./dist && tsc -w",
    "hush": "yarn build && node dist/hush.js",
    "prettier": "prettier --write --ignore-unknown .",
    "eslint": "eslint .",
    "eslint:fix": "eslint --fix .",
    "prepack": "rm -rf dist && yarn build && yarn test",
    "test": "vitest test/unit --run",
    "test:integration": "vitest test/integration --run",
    "test:unit": "vitest test/unit --run",
    "test:watch": "vitest test/unit",
    "test:integration:watch": "vitest test/integration",
    "commit": "commit",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/prompt-cli": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/figlet": "^1.5.6",
    "@types/node": "^24",
    "aws-sdk-client-mock": "^4.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1144.0",
    "@aws-sdk/client-sts": "^3.1144.0",
    "@thinkinglabs/aws-iam-policy": "^2.5.1",
    "chalk": "^4.1.0-commonjs",
    "commander": "^10.0.1",
    "date-fns": "^2.30.0",
    "figlet": "^1.6.0"
  }
}
